# Copy to .env.local and fill in. Never commit .env.local or any real value.

# Base URL of the New CP API (no trailing slash). Placeholder only.
VITE_API_BASE_URL=https://api.example.test

# true = use the contract-shaped mocks in src/mocks/ (from A2); false = call the API above.
VITE_USE_MOCKS=true

# Google OAuth client ID for sign-in (A4). Placeholder only; the real value comes from the team.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Integration with the New CP test server (A30) ---------------------------
# Put these in .env.integration.local (git-ignored) and run `npm run dev:integration`.
# The dev server proxies /api to the target, so the browser stays same-origin (no CORS, Q-B31).
# VITE_USE_MOCKS=false
# VITE_API_BASE_URL=/
# VITE_API_PROXY_TARGET=http://<test-server-host>:<port>
# VITE_GOOGLE_CLIENT_ID=<public Google OAuth web client ID from Hesham>
